# Runtime image for the Odessa API + Tango bridge.
# Extends python:3.12-slim with the OS libraries headless Chromium needs
# (Playwright's browser binary is installed into a shared volume at setup time).
# App source is bind-mounted at runtime — nothing is baked in here.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 \
      libcairo2 libcups2 libdbus-1-3 libdrm2 libexpat1 libfontconfig1 \
      libgbm1 libglib2.0-0 libnspr4 libnss3 libpango-1.0-0 \
      libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 \
      libxext6 libxfixes3 libxkbcommon0 libxrandr2 libxshmfence1 \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
