{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "api/**/*.js",
    "scripts/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "api/**/*.js",
    "e2e/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ],
  "ignoreBinaries": [
    "venvScriptspython.exe"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "duplicates": "error"
  }
}
