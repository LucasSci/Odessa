{
  "name": "odessa-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "hostinger-server.mjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "venv\\Scripts\\python.exe -m uvicorn server.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:n8n": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-n8n.ps1",
    "start": "node hostinger-server.mjs",
    "hostinger:build": "npm run build",
    "hostinger:start": "node hostinger-server.mjs",
    "build": "vite build",
    "generate:branding": "venv\\Scripts\\python.exe scripts\\generate-branding-assets.py",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "arch": "arch-contract check",
    "knip": "knip",
    "format": "prettier --write .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "budget": "node scripts/check-bundle-budget.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm arch && pnpm knip && pnpm test:unit",
    "simulate:live": "node scripts/simulate-live-round.mjs",
    "test:backend": "venv\\Scripts\\python.exe -m pytest"
  },
  "dependencies": {
    "@sentry/react": "^11.0.0",
    "@xyflow/react": "^12.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "obs-websocket-js": "^5.0.8",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "arch-contract": "^0.3.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.38.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
